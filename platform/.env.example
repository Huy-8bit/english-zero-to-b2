# Path to the curriculum Markdown (defaults to the folder that contains platform/)
# CONTENT_ROOT=/absolute/path/to/english-zero-to-b2

# SQLite by default; any SQLAlchemy URL works, e.g. postgresql+psycopg://user:pass@localhost/english
# DATABASE_URL=sqlite:///./backend/data/english.db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTENT_RELOAD_SECONDS=3

# Optional AI tutor. Leave empty to disable; keys stay on the server and are never sent to the browser.
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
