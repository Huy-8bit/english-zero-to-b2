# Curriculum path defaults to the folder containing platform/.
# CONTENT_ROOT=/absolute/path/to/english-zero-to-b2
# Local only. Prefer an absolute path; Docker fixes its DB at /data/english.db.
# DATABASE_URL=sqlite:////absolute/path/to/english.db
# MEDIA_DIR=/absolute/path/to/media
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CONTENT_RELOAD_SECONDS=3

# One local learner. Set a long random access token before exposing the app.
APP_ACCESS_TOKEN=
# Docker listens only on localhost by default.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Keep this name when upgrading/redeploying; changing it selects a different DB.
LEARNING_DATA_VOLUME=english-mastery_learning-data

# Optional AI; keep keys on the backend. No key = curriculum still works.
# fake is for automated tests only and is explicitly labelled in the UI.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_TUTOR=gpt-5.4-mini
OPENAI_MODEL_EXERCISE=gpt-5.4-mini
OPENAI_MODEL_GRADING=gpt-5.4-mini
OPENAI_MODEL_COMPLEX_GRADING=gpt-6.1-sol
OPENAI_MODEL_TRANSCRIPTION=gpt-4o-mini-transcribe
OPENAI_MODEL_TTS=gpt-4o-mini-tts
OPENAI_MODEL_REALTIME=gpt-realtime-mini
OPENAI_MODEL_EMBEDDING=text-embedding-3-small
OPENAI_TTS_VOICE=marin
# Leave unset unless every configured text model supports the chosen effort.
# OPENAI_REASONING_EFFORT=low
AI_TIMEOUT_SECONDS=45
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=12
AI_DAILY_REQUEST_LIMIT=300
AI_MONTHLY_BUDGET_USD=10
AI_MAX_AUDIO_SECONDS=120
AI_MAX_AUDIO_MB=8
AI_MAX_EXERCISE_COUNT=20
AI_VERIFY_EXERCISES=true
AI_STORE_USER_AUDIO=false
AI_USE_EMBEDDINGS=false
AI_REALTIME_MAX_SECONDS=300
# Override estimates for custom models; see app/ai/settings.py for units.
# OPENAI_PRICING_JSON={"custom-model":{"input":1.0,"output":5.0}}
